{
  "name": "@graphyne/web-components",
  "version": "0.1.0",
  "description": "Graphyne Web Components — authored as Vue 3 SFCs, published as framework-agnostic custom elements.",
  "type": "module",
  "license": "MIT",
  "author": "Shay Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaysingh818/graphyne-web-component-library.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://shaysingh818.github.io/graphyne-web-component-library/",
  "bugs": {
    "url": "https://github.com/shaysingh818/graphyne-web-component-library/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "web-components",
    "custom-elements",
    "component-library"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/graphyne-web-components.js",
  "module": "./dist/graphyne-web-components.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/graphyne-web-components.js"
    },
    "./elements": {
      "types": "./dist/index.d.ts",
      "import": "./dist/elements/graphyne-elements.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/elements/*"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.elements.config.ts && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist storybook-static"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-onboarding": "^10.5.8",
    "@storybook/vue3-vite": "^10.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^25.0.0",
    "rimraf": "^6.0.0",
    "storybook": "^10.5.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.1.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "vue-chartjs": "^5.3.4"
  }
}
